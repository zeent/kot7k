# Central TLS endpoint: auth.kot7k.zeent.dev
# The backend must not be reachable directly from the public Internet.
ssl_client_certificate /etc/nginx/fnmt/client-ca-chain.pem;
ssl_verify_client optional;
ssl_verify_depth 4;

# Enable at least one maintained revocation mechanism.
ssl_ocsp on;
ssl_ocsp_cache shared:client_ocsp:10m;
resolver 1.1.1.1 8.8.8.8 valid=300s;
# ssl_crl /etc/nginx/fnmt/client-ca-crls.pem;

location = /api/authentication/x509/callback/ {
    proxy_set_header X-SSL-Client-Verify "";
    proxy_set_header X-SSL-Client-Cert "";
    proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
    proxy_set_header X-SSL-Client-Cert $ssl_client_escaped_cert;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_pass http://127.0.0.1:8000;
}
